# Copy this file to ".env" and fill it in. Never commit .env to GitHub.

# Supabase → Project Settings → API (Data API / API Keys)
SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_…) or the legacy "anon" key. Safe to be public.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# "Secret" key (sb_secret_…) or the legacy "service_role" key. KEEP THIS PRIVATE.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# The email of the Supabase Auth user allowed into the Creator Studio.
# Several people? Separate with commas.
CREATOR_EMAIL=you@example.com

# Optional
# PORT=3000
# PUBLIC_URL=https://your-site.onrender.com
# MAX_UPLOAD_MB=50
# SUPABASE_BUCKET=media
